- name: Early consent flags consentUpdateAlreadySent for the SDK
  code: |-
    const cookie = JSON.stringify({
      '$$completed': true,
      '$$googleConsentMode': {ad_storage: 'granted'}
    });
    let settings;
    mock('getCookieValues', () => [cookie]);
    mock('setInWindow', (key, value) => { settings = value; });

